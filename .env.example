# Copy to .env.local and fill in. .env.local is not committed.

# The ship assistant's model (Ollama, server side only)
OLLAMA_API_KEY=
# Optional overrides
# OLLAMA_CHAT_URL=https://ollama.vessel-ai.eu/api/chat
# ASSISTANT_MODEL=ministral-3:8b   (also: maritime-ministral3:latest, mistral:7b)

# The data pipeline's GraphDB, for the knowledge graph (server side only).
# Unset: the bundled export features/ship-visualizer/data/futuristic-vessel-kg.json is shown.
# Locally, with the pipeline's docker compose (see the README):
# GRAPHDB_URL=http://localhost:7200
# GRAPHDB_REPOSITORY=futuristic-vessel
# GRAPHDB_TOKEN_URL=http://keycloak:8080/realms/twinship/protocol/openid-connect/token
# GRAPHDB_CLIENT_ID=dagster-pipeline
# GRAPHDB_CLIENT_SECRET=local-dev-dagster-client-secret   (the pipeline's KEYCLOAK_CLIENT_SECRET; this is its local default)
